#! /usr/bin/env bash

# Make sure libs are built first

# Clean the previous wrf build
cd wrf-4.6.1
./clean -a
cd ..

#  Set env vars
source ./set-env

apply_static_link_overrides() {
    local configure_file="configure.wrf"
    local gcc_libdir

    if [[ ! -f "${configure_file}" ]]; then
        echo "Error: ${configure_file} not found after configure" >&2
        exit 1
    fi

    gcc_libdir="$(dirname "$(gfortran -print-file-name=libgfortran.a)")"
    for archive in libgfortran.a libgomp.a libquadmath.a; do
        if [[ ! -f "${gcc_libdir}/${archive}" ]]; then
            echo "Error: ${gcc_libdir}/${archive} not found" >&2
            exit 1
        fi
    done

    # Keep only order-independent runtime flags in LDFLAGS_LOCAL; WRF places LDFLAGS before object files.
    sed -i 's|^LDFLAGS_LOCAL[[:space:]]*=.*|LDFLAGS_LOCAL   =       -m64 -static-libgcc -static-libgfortran|' "${configure_file}"

    # Force WRF's generated NetCDF link flags to select static archives rather than any shared libraries found first.
    sed -i 's|-lnetcdff -lnetcdf|-l:libnetcdff.a -l:libnetcdf.a|g' "${configure_file}"

    # Add order-sensitive runtime archives through LIB_LOCAL, which WRF links after its object files and static libraries.
    sed -i "/^LIB_LOCAL[[:space:]]*=/ s|$| -L${gcc_libdir} -Wl,-Bstatic -l:libgomp.a -l:libquadmath.a -Wl,-Bdynamic|" "${configure_file}"
}

#  Configure wrf

#  -- Output from configure --
#  NEEDS CHECKING IF OK

# checking for perl5... no
#checking for perl... found /usr/bin/perl (perl)
#Will use NETCDF in dir: /home/ubuntu/wrf/libraries/netcdf
#ADIOS2 not set in environment. Will configure WRF for use without.
#HDF5 not set in environment. Will configure WRF for use without.
#PHDF5 not set in environment. Will configure WRF for use without.
#Will use 'time' to report timing information
#$JASPERLIB or $JASPERINC not found in environment, configuring to build without grib2 I/O...

#  33 = (smpar) GNU gcc/gfortran
#   1 = basic nesting: parent domain with one or more nested domains.
cd wrf-4.6.1
./configure << -EOF-
33
1
-EOF-
apply_static_link_overrides

# Now configure the serial build of WRF that WPS needs
# 32 = serial
cd ../wrf-4.6.1-serial
./configure << -EOF-
32
1
-EOF-
apply_static_link_overrides



#! /usr/bin/env bash

# Make sure libs are built first

# Clean the previous wrf build
cd wrf-4.6.1
./clean -a
cd ..

#  Set env vars
source ./set-env

apply_lib_overrides() {
    local configure_file="configure.wrf"
    local gcc_libdir

    if [[ ! -f "${configure_file}" ]]; then
        echo "Error: ${configure_file} not found after configure" >&2
        exit 1
    fi

    gcc_libdir="$(dirname "$(gfortran -print-file-name=libgfortran.a)")"
    for archive in libgfortran.a libgomp.a libquadmath.a; do
        if [[ ! -f "${gcc_libdir}/${archive}" ]]; then
            echo "Error: ${gcc_libdir}/${archive} not found" >&2
            exit 1
        fi
    done

    # Keep only order-independent runtime flags in LDFLAGS_LOCAL; WRF places LDFLAGS before object files.
    sed -i 's|^LDFLAGS_LOCAL[[:space:]]*=.*|LDFLAGS_LOCAL  =  -m64 -static-libgcc |' "${configure_file}"

    # Force WRF's generated NetCDF link flags to select static archives rather than any shared libraries found first.
    sed -i 's|-lnetcdff -lnetcdf|-l:libnetcdff.a -l:libnetcdf.a|g' "${configure_file}"

    # Add order-sensitive runtime archives through LIB_LOCAL, which WRF links after its object files and static libraries.
    # LIB_LOCAL is not present in every generated configure.wrf, so create it when the template omits it.
    if grep -q '^LIB_LOCAL[[:space:]]*=' "${configure_file}"; then
        sed -i "/^LIB_LOCAL[[:space:]]*=/ s|$| -L${gcc_libdir} -Wl,-Bstatic -l:libgfortran.a -l:libgomp.a -l:libquadmath.a -Wl,-Bdynamic -ldl|" "${configure_file}"
    else
        sed -i "/^LDFLAGS_LOCAL[[:space:]]*=/ a LIB_LOCAL  =  -L${gcc_libdir} -Wl,-Bstatic -l:libgfortran.a -l:libgomp.a -l:libquadmath.a -Wl,-Bdynamic -ldl" "${configure_file}"
    fi
}

apply_compile_overrides() {
    local configure_file="configure.wrf"

    if [[ ! -f "${configure_file}" ]]; then
        echo "Error: ${configure_file} not found after configure" >&2
        exit 1
    fi

    # Change the default "debug" flag to include a traceback and catch useful FPE errors.
    sed -i 's|^FCDEBUG[[:space:]]*=*|FCDEBUG  =  -g -fbacktrace -ffpe-trap=invalid,zero,overflow|' "${configure_file}"
}


################
#  Configure wrf
################

#  33 = (smpar:OpenMP) GNU gcc/gfortran
#   1 = basic nesting: parent domain with one or more nested domains.

cd wrf-4.6.1
./configure << -EOF-
33
1
-EOF-
apply_lib_overrides
apply_compile_overrides

# Now configure the serial build of WRF that WPS needs
# 32 = serial

cd ../wrf-4.6.1-serial
./configure << -EOF-
32
1
-EOF-
apply_lib_overrides
apply_compile_overrides

